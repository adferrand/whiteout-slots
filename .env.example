# Provided automatically by the Neon integration on Vercel
# (run `vercel env pull .env.local` to get it locally).
DATABASE_URL=postgres://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Admin access: one shared password, and a long random string to sign the session cookie
# and salt IP hashes (e.g. `openssl rand -base64 32`).
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Displayed in the header
NEXT_PUBLIC_SERVER_NUMBER=1460
